# Export these in your shell; .env is not automatically loaded.
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback
# Optional absolute path outside your repository:
# SPOTIFY_CACHE_PATH=/private/path/spotify-token.json

# Album profile only: use a private directory outside the checkout, identical
# during --auth and in your MCP client's environment. One home per account.
# SPOTIFY_ALBUM_HOME=/absolute/private/path/spotify-albums-personal
